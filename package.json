{
  "name": "lviv-arena-cms",
  "version": "1.0.0",
  "description": "Lviv Arena - Cyber Sports Club Platform with official Payload CMS Admin Panel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:cms": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:next",
    "build:cms": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:cms": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "dev:next": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build:next": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start:next": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:check": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/checkDatabaseConnection.ts",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:reconcile-payment-booking": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/reconcilePaymentBookingRelation.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed:lviv-arena": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/runSeed.ts",
    "tariffs:set-prices": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/setTariffPrices.ts",
    "create:admin": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/createAdmin.ts",
    "admin:promote": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/promoteAdmin.ts",
    "cms:seed-landing": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seedLandingCms.ts",
    "admin:reset-password": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/resetAdminPassword.ts",
    "admin:verify-login": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/verifyAdminLogin.ts",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@payloadcms/admin-bar": "3.91.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-form-builder": "3.91.0",
    "@payloadcms/plugin-nested-docs": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-search": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "express": "^5.3.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "next": "16.3.3",
    "next-sitemap": "^4.2.3",
    "payload": "3.91.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/escape-html": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
